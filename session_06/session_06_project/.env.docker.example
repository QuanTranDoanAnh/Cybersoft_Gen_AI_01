# Cổng mở ứng dụng trên máy host
APP_PORT=3000
FRONTEND_ORIGIN=http://localhost:3000

# PostgreSQL nội bộ Docker
DB_HOST=datacenter
DB_PORT=5432
DB_USER=orbit_user
DB_PASS=replace-with-a-strong-password
DATABASE=orbit

# Bảo mật ứng dụng
JWT_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_SECURE=false

# OpenAI (để trống nếu muốn dùng Copilot demo cục bộ)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini